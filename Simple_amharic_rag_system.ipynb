   "source": [
    "import torch\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM, pipeline\n",
    "\n",
    "llm_model_id = \"CohereLabs/tiny-aya-earth\"\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(llm_model_id)\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    llm_model_id,\n",
    "    torch_dtype=torch.bfloat16 if torch.cuda.is_available() else torch.float32,\n",
    "    device_map=\"auto\",\n",
    ")\n",
    "\n",
    "generator = pipeline(\n",
    "    \"text-generation\",\n",
    "    model=model,\n",
    "    tokenizer=tokenizer,\n",
    ")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "njdYAGBOGJP2",
   "metadata": {
    "id": "njdYAGBOGJP2"
   },
   "source": [
    "### Build the retrieval + generation (RAG) function\n",
    "\n",
    "We pick a retriever from the vectorstores built above — `vectorstore_baai` (BAAI/bge-m3) is used by default since it is a strong general multilingual embedder, but you can swap in `vectorstore_intfloat` or `vectorstore_rasyosef` based on the similarity comparisons in the cells above."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "Qc6tp1oxGJP3",
   "metadata": {
    "id": "Qc6tp1oxGJP3"
   },
   "outputs": [],
   "source": [
    "retriever = vectorstore_baai.as_retriever(search_kwargs={\"k\": 3})\n",
    "\n",
    "def build_context(question, k=3):\n",
    "    docs = retriever.invoke(question)\n",
    "    context = \"\\n\\n\".join(doc.page_content for doc in docs)\n",
    "    return context, docs\n",
    "\n",
    "def rag_answer(question, max_new_tokens=300, temperature=0.3):\n",
    "    context, docs = build_context(question)\n",
    "\n",
    "    system_prompt = (\n",
    "        \"You are a helpful assistant that answers questions in Amharic. \"\n",
    "        \"Use ONLY the provided context to answer the question. \"\n",
    "        \"If the answer is not contained in the context, say so honestly in Amharic.\"\n",
    "    )\n",
    "    user_prompt = f\"አውድ (Context):\\n{context}\\n\\nጥያቄ (Question): {question}\\n\\nመልስ (Answer):\"\n",
    "\n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": system_prompt},\n",
    "        {\"role\": \"user\", \"content\": user_prompt},\n",
    "    ]\n",
    "\n",
    "    outputs = generator(\n",
    "        messages,\n",
    "        max_new_tokens=max_new_tokens,\n",
    "        do_sample=temperature > 0,\n",
    "        temperature=max(temperature, 1e-5),\n",
    "        top_p=0.95,\n",
    "    )\n",
    "\n",
    "    reply = outputs[0][\"generated_text\"][-1][\"content\"]\n",
    "    return reply, docs\n"
   ]
  },
