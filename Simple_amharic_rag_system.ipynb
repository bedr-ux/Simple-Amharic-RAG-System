    "# Generate both sets of answers\n",
    "with_rag_rows, without_rag_rows = [], []\n",
    "\n",
    "for item in eval_set:\n",
    "    q, ref = item[\"question\"], item[\"reference\"]\n",
    "\n",
    "    rag_ans, rag_docs = rag_answer(q)\n",
    "    with_rag_rows.append({\n",
    "        \"user_input\": q,\n",
    "        \"retrieved_contexts\": [d.page_content for d in rag_docs],\n",
    "        \"response\": rag_ans,\n",
    "        \"reference\": ref,\n",
    "    })\n",
    "\n",
    "    plain_ans = no_rag_answer(q)\n",
    "    without_rag_rows.append({\n",
    "        \"user_input\": q,\n",
    "        \"retrieved_contexts\": [],       # no retrieval happened\n",
    "        \"response\": plain_ans,\n",
    "        \"reference\": ref,\n",
    "    })\n",
    "\n",
    "    print(f\"Q: {q}\\n  [RAG]    {rag_ans}\\n  [No RAG] {plain_ans}\\n\")\n"
   ]
