   "source": [
    "import numpy as np\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "# 2. Define the two sentences you want to compare\n",
    "sentence_1 = \"ቴክኖሎጂ በከፍተኛ ፍጥነት እያደገ ነው።\"\n",
    "sentence_2 = \"i ate banana.\"\n",
    "\n",
    "# 3. Generate numerical vector embeddings for both sentences\n",
    "vec_1 = rasyosef_embebder.embed_query(sentence_1)\n",
    "vec_2 = rasyosef_embebder.embed_query(sentence_2)\n",
    "vec_3 = baai_embder.embed_query(sentence_1)\n",
    "vec_4 = baai_embder.embed_query(sentence_2)\n",
    "vec_5 = intfloat_embder.embed_query(sentence_1)\n",
    "vec_6 = intfloat_embder.embed_query(sentence_2)\n",
    "\n",
    "# 4. Reshape vectors to fit the sklearn format (1, -1)\n",
    "vec_1_reshaped = np.array(vec_1).reshape(1, -1)\n",
    "vec_2_reshaped = np.array(vec_2).reshape(1, -1)\n",
    "vec_3_reshaped = np.array(vec_3).reshape(1, -1)\n",
    "vec_4_reshaped = np.array(vec_4).reshape(1, -1)\n",
    "vec_5_reshaped = np.array(vec_5).reshape(1, -1)\n",
    "vec_6_reshaped = np.array(vec_6).reshape(1, -1)\n",
    "\n",
    "# 5. Compute the Cosine Similarity score (ranges from -1 to 1)\n",
    "similarity_score = cosine_similarity(vec_1_reshaped, vec_2_reshaped)[0][0]\n",
    "similarity_score_1 = cosine_similarity(vec_3_reshaped, vec_4_reshaped)[0][0]\n",
    "similarity_score_2 = cosine_similarity(vec_5_reshaped, vec_6_reshaped)[0][0]\n",
    "\n",
    "print(f\"Sentence 1: '{sentence_1}'\")\n",
    "print(f\"Sentence 2: '{sentence_2}'\")\n",
    "print(f\"Semantic Similarity Score of Rasyosef_embdder: {similarity_score:.4f}\")\n",
    "print(f\"Semantic Similarity Score of Baai embder: {similarity_score_1:.4f}\")\n",
    "print(f\"Semantic Similarity Score of Intfloat embder: {similarity_score_2:.4f}\")\n",
    "\n",
    "\n",
    "#we will select the highest sematic similarity score embder for embedding the chunking docuemnt\n"
