   "outputs": [],
   "source": [
    "def no_rag_answer(question, max_new_tokens=300, temperature=0.3):\n",
    "    \"\"\"Ask the model directly, with no retrieved context at all.\"\"\"\n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": \"You are a helpful assistant that answers questions in Amharic.\"},\n",
    "        {\"role\": \"user\", \"content\": question},\n",
    "    ]\n",
    "    outputs = generator(\n",
    "        messages,\n",
    "        max_new_tokens=max_new_tokens,\n",
    "        do_sample=temperature > 0,\n",
    "        temperature=max(temperature, 1e-5),\n",
    "        top_p=0.95,\n",
    "    )\n",
    "    return outputs[0][\"generated_text\"][-1][\"content\"]\n"
   ]
