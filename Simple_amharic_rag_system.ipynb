    "from langchain_huggingface import HuggingFaceEmbeddings\n",
    "# 1. Initialize the target embedding architectures\n",
    "\n",
    "# Initialize the native Amharic embedding model\n",
    "rasyosef_embebder = HuggingFaceEmbeddings(model_name=\"rasyosef/roberta-amharic-text-embedding-base\")\n",
    "# Initialize the multilingual embedding model\n",
    "baai_embder = HuggingFaceEmbeddings(model_name=\"BAAI/bge-m3\")\n",
    "intfloat_embder = HuggingFaceEmbeddings(model_name=\"intfloat/multilingual-e5-large\")\n"
   ]
