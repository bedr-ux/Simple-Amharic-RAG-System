    "        \"የበልግ ወቅት አጭር ዝናብ የሚያመጣ ወቅት ነው።\",\n",
    "        \"የሀገሪቱ የአየር ንብረት እንደ ከፍታ ይለያያል።\",\n",
    "        \"ደመና በሰማይ ላይ ተንሰራፍቶ ፀሐይን ሸፈነው።\",\n",
    "    ],\n",
    "    \"education_school\": [\n",
    "        \"ተማሪዎች በየቀኑ ጠዋት ወደ ትምህርት ቤት ይሄዳሉ።\",\n",
    "        \"የመንግስት ትምህርት ቤቶች ነጻ ትምህርት ይሰጣሉ።\",\n",
    "        \"መምህራን ለተማሪዎች የቤት ስራ ይሰጣሉ።\",\n",
    "        \"ዩኒቨርሲቲዎች የከፍተኛ ትምህርት እድል ይሰጣሉ።\",\n",
    "        \"ተማሪዎች ፈተና ከመውሰዳቸው በፊት ያጠናሉ።\",\n",
    "        \"የትምህርት ጥራት ማሻሻል የመንግስት ቅድሚያ ተግባር ነው።\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "all_sentences = [(topic, s) for topic, sents in sentences.items() for s in sents]\n",
    "print(f\"Total sentences: {len(all_sentences)}\")\n",
    "\n",
    "models = {\n",
    "    \"rasyosef\": rasyosef_embebder,\n",
    "    \"bge-m3\": baai_embder,\n",
    "    \"e5-large (query prefix)\": intfloat_embder,\n",
    "}\n",
    "\n",
    "def get_embedding(embedder, text, model_name):\n",
    "    if \"e5\" in model_name:\n",
    "        text = f\"query: {text}\"\n",
    "    return np.array(embedder.embed_query(text))\n",
    "\n",
    "results = {}\n",
    "\n",
    "for model_name, embedder in models.items():\n",
    "    print(f\"\\nEmbedding with {model_name}...\")\n",
    "    vectors = [get_embedding(embedder, s, model_name) for _, s in all_sentences]\n",
    "\n",
    "    within_sims = []\n",
    "    across_sims = []\n",
    "\n",
    "    for i, j in combinations(range(len(all_sentences)), 2):\n",
    "        topic_i, _ = all_sentences[i]\n",
    "        topic_j, _ = all_sentences[j]\n",
    "        sim = cosine_sim(vectors[i], vectors[j])\n",
    "        if topic_i == topic_j:\n",
    "            within_sims.append(sim)\n",
    "        else:\n",
    "            across_sims.append(sim)\n",
    "\n",
    "    within_mean = np.mean(within_sims)\n",
    "    across_mean = np.mean(across_sims)\n",
    "    gap = within_mean - across_mean\n",
    "\n",
    "    results[model_name] = {\n",
    "        \"within_mean\": within_mean,\n",
    "        \"within_std\": np.std(within_sims),\n",
    "        \"across_mean\": across_mean,\n",
    "        \"across_std\": np.std(across_sims),\n",
    "        \"gap\": gap,\n",
    "    }\n",
    "\n",
    "    print(f\"  Within-topic sim:  {within_mean:.4f} (± {np.std(within_sims):.4f})\")\n",
    "    print(f\"  Across-topic sim:  {across_mean:.4f} (± {np.std(across_sims):.4f})\")\n",
    "    print(f\"  Separation gap:    {gap:.4f}\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*50)\n",
    "print(\"SUMMARY (sorted by separation gap, higher = better)\")\n",
    "print(\"=\"*50)\n",
    "for name, r in sorted(results.items(), key=lambda x: -x[1][\"gap\"]):\n",
    "    print(f\"{name:30s} gap={r['gap']:.4f}  (within={r['within_mean']:.3f}, across={r['across_mean']:.3f})\")"
   ]
